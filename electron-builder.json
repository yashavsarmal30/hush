{
  "appId": "com.yashavsarmal.hush",
  "productName": "Hush",
  "directories": {
    "output": "dist-package"
  },
  "publish": {
    "provider": "github",
    "owner": "yashavsarmal30",
    "repo": "hush"
  },
  "files": [
    "dist-app/**/*",
    "dist-electron/**/*",
    "package.json",
    "public/**/*"
  ],
  "extraResources": [
    {
      "from": "dist/hush-engine",
      "to": "engine",
      "filter": ["**/*"]
    },
    {
      "from": "hush",
      "to": "hush",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "build_assets/hush.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Hush"
  }
}
